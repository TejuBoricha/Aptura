# OS / editor noise
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*~
*.swp
*.swo

# Recovery/scratch artifacts from editing sessions
*.bak
*.CORRUPTED.*
*_RECON*.md
*.tmp

# Build output and machine-local configuration
.gradle/
build/
*.apk
*.aab
*.ap_
local.properties
.kotlin/
.cxx/

# Signing keys and certificates: never commit these (SEC-01)
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.p8
*.key
id_rsa
id_ecdsa
id_ed25519

# Environment files hold secrets; the example file is the one that may be committed.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Generated Media Fixtures (manifest.csv and adv_sub text files are tracked)
fixtures/**/*.mp4
fixtures/**/*.mkv
fixtures/**/*.mov
fixtures/**/*.webm
fixtures/**/*.ts
fixtures/**/*.3gp
fixtures/**/*.avi
fixtures/**/*.flv
fixtures/**/*.ogv
fixtures/**/*.wmv
fixtures/**/*.mpg
fixtures/**/*.wtv
fixtures/**/*.mxf
fixtures/**/*.rm
fixtures/**/*.rmvb
fixtures/**/*.m4a
fixtures/**/*.flv
fixtures/**/*.flac
fixtures/scale/
fixtures/meta_bombs/tags/
fixtures/meta_bombs/artwork/
fixtures/meta_bombs/paths/

# IDE / local tooling
.idea/
*.iml
.vscode/
opencode.jsonc

# Ad-hoc emulator dumps (evidence belongs in the PR)
tools/captures/

# Python bytecode (tools/agents)
__pycache__/
*.pyc
