        android:fillType="evenOdd"
        android:pathData="M54,25.5234A28.4766,28.4766 0 1,1 54,82.4766A28.4766,28.4766 0 1,1 54,25.5234Z M70.2422,54L45.8789,68.066L45.8789,39.934Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="25.5"
                android:startY="25.5"
                android:endX="82.5"
                android:endY="82.5">
                <item android:offset="0" android:color="#FF6FF3FF" />
                <item android:offset="1" android:color="#FF00A8C4" />
            </gradient>
        </aapt:attr>
    </path>
