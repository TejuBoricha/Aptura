<?xml version="1.0" encoding="utf-8"?>
<!--
    Full backup rules for Android 6.0 to 11 (API 23-30) per SEC-08.
    Explicitly excludes all local storage domains from Auto Backup,
    enforcing zero-leakage offline media player privacy invariants.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
